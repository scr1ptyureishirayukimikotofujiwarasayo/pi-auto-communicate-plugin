{
  "name": "pi-autocomm",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "An advisor-model loop for the Pi coding agent: any provider reviews Pi's work and suggests the next milestone.",
  "keywords": ["pi-package", "advisor", "agent"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scr1ptyureishirayukimikotofujiwarasayo/pi-auto-communicate-plugin.git"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "test": "node --test",
    "typecheck": "tsc --noEmit --allowImportingTsExtensions --module esnext --moduleResolution bundler --target es2022 --skipLibCheck extension.ts"
  },
  "pi": {
    "extensions": ["./extension.ts"]
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.7.0",
    "@types/node": "^26.6.11",
    "typescript": "^5.9.3"
  }
}
